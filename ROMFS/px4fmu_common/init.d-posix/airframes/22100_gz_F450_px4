#!/bin/sh
#
# @name Gazebo F450 (FxTESO IBVS)
#
# @type Quadrotor
# @class Copter
#
# DJI F450, modelled in quad_description/models/F450_px4 in the fxteso_ibvs workspace.
# This fork exists to carry this airframe; the gains below were measured, not inherited.

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=ibvs}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=F450_px4}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Rotor positions in FRD, from the F450_px4 link poses (FLU, y negated).
# Must match the motor->link mapping in F450_px4/model.sdf.
# KM and CT now match the SDF's momentConstant and C_T*maxRotVelocity^2; KM was 0.05 against
# the SDF's 0.016, inherited from x500. Both are inert here - ActuatorEffectivenessRotors sets
# normalize_rpy, so each column of the mix is divided by its own max and the scale cancels.
param set-default CA_ROTOR0_PX 0.1589
param set-default CA_ROTOR0_PY 0.1589
param set-default CA_ROTOR0_KM 0.016
param set-default CA_ROTOR0_CT 8.549

param set-default CA_ROTOR1_PX -0.1589
param set-default CA_ROTOR1_PY -0.1589
param set-default CA_ROTOR1_KM 0.016
param set-default CA_ROTOR1_CT 8.549

param set-default CA_ROTOR2_PX 0.1589
param set-default CA_ROTOR2_PY -0.1589
param set-default CA_ROTOR2_KM -0.016
param set-default CA_ROTOR2_CT 8.549

param set-default CA_ROTOR3_PX -0.1589
param set-default CA_ROTOR3_PY 0.1589
param set-default CA_ROTOR3_KM -0.016
param set-default CA_ROTOR3_CT 8.549

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1089
param set-default SIM_GZ_EC_MAX2 1089
param set-default SIM_GZ_EC_MAX3 1089
param set-default SIM_GZ_EC_MAX4 1089

# --- attitude and rate loop ---------------------------------------------------
# PX4's defaults are the x500's. Rate gains scale with inertia/torque-arm: roll x2.30,
# pitch x1.61, yaw x1.29 - roll is the soft axis, not pitch, because x500's arms are
# asymmetric (PY 0.22 roll, PX 0.13 pitch) against the F450's 0.1589 on both. Re-derive if
# the inertia, the arm positions or the motor constants change.
# The yaw lag of 556 ms against roll's 244 is not explained by CA_ROTOR*_KM: that scale cancels
# in the RPY normalisation. Still unexplained.
param set-default MC_ROLLRATE_P 0.345
param set-default MC_ROLLRATE_I 0.460
param set-default MC_ROLLRATE_D 0.0069

param set-default MC_PITCHRATE_P 0.242
param set-default MC_PITCHRATE_I 0.322
param set-default MC_PITCHRATE_D 0.0048

param set-default MC_YAWRATE_P 0.259
param set-default MC_YAWRATE_I 0.129

# MC_ROLL_P / MC_PITCH_P / MC_YAW_P are left at PX4's defaults on purpose. Raising them cut
# the attitude lag but tripled the image-moment noise and lost lock sooner - the IBVS layer
# minds moment noise far more than lag. The yaw drift is fixed in fixed_eso.cpp, not here.

# 4S with a 9545: T/W 2.07 at 2.0 kg. sitl.launch.py derives this and SIM_GZ_EC_MAX together
# from battery_cells and overrides both via PX4_PARAM_*; these defaults are for a bare
# px4_sitl_default run. Must equal px4_offboard_bridge's hover_thrust parameter.
param set-default MPC_THR_HOVER 0.6461

# The servoing depth. sitl.launch.py derives image_features' aD from its zD:= argument and
# pushes the same number in as PX4_PARAM_MIS_TAKEOFF_ALT, so this default is only for a bare
# px4_sitl_default run. Takeoff has to deliver the aircraft to the depth aD was computed for
# or the feature vector is mis-scaled from the first frame.
param set-default MIS_TAKEOFF_ALT 2.5

# Offboard loss = loss of visual lock; px4_offboard_bridge drops the stream on a stale
# setpoint. 5 is Hold, so the aircraft loiters rather than landing.
param set-default COM_OBL_RC_ACT 5
param set-default COM_OF_LOSS_T 1.0

# Zero declination, matching the world's magnetic_field in ibvs.sdf. Bit 0 clear = ignore the
# geo_lookup value. Estimated yaw then reads against the world's North, which pos_ctrl assumes.
param set-default EKF2_DECL_TYPE 0
param set-default EKF2_MAG_DECL 0

# EKF2 gates mag heading fusion on "is yaw observable", i.e. horizontal acceleration above
# EKF2_MAG_ACCLIM, whenever GNSS NE aiding is active (mag_control.cpp checkMagHeadingConsistency).
# This aircraft station-keeps over a marker and never accelerates that hard, so heading aiding
# dropped out ~21 s in and never returned: yaw then dead-reckoned on the gyro and the estimate
# ran 33 deg off truth, which rotates Ryaw() inside pos_ctrl and fixed_eso. The gz magnetometer
# is ideal and the world field uniform, so the heuristic is protecting against nothing here.
param set-default EKF2_MAG_ACCLIM 0.0

# The gz IMU is perfect by construction, so a learned calibration can only inject error.
# SENS_IMU_AUTOCAL had written CAL_ACC0_XOFF -0.287 m/s^2 into rootfs/parameters.bson: 1.68 deg
# of standing pitch bias, i.e. 0.27 m/s^2 of uncommanded forward acceleration on every flight.
# `param set`, not set-default, because a saved value overrides a default.
param set-default SENS_IMU_AUTOCAL 0
param set CAL_ACC0_XOFF 0.0
param set CAL_ACC0_YOFF 0.0
param set CAL_ACC0_ZOFF 0.0
param set CAL_GYRO0_XOFF 0.0
param set CAL_GYRO0_YOFF 0.0
param set CAL_GYRO0_ZOFF 0.0

# No RC and no GCS in SITL. Without these, arming is blocked and the loss failsafes fire.
param set-default COM_RC_IN_MODE 4
param set-default NAV_DLL_ACT 0
param set-default NAV_RCL_ACT 0
